# Optional instructions file passed by ./codex-instructions.
# Default: unset
CODEX_INSTRUCTIONS_FILE=

# Directory for dispatch.sh summary and log files.
# Default: ${TMPDIR:-/tmp}/codex-wire
CODEX_WIRE_OUTDIR=

# Job tracking file used by codex_monitor.py.
# Default: ~/.codex/codex_wire_jobs.json
CODEX_MONITOR_TRACK_PATH=~/.codex/codex_wire_jobs.json

# Number of session JSONL files to scan.
# Default: 80
CODEX_MONITOR_SESSION_LIMIT=80

# Number of completed/recent sessions to show.
# Default: 50
CODEX_MONITOR_RECENT_LIMIT=50

# Seconds before a live job is considered stale.
# Default: 120
CODEX_MONITOR_STALE_SEC=120

# Seconds of session events to include in the global feed.
# Default: 1800
CODEX_MONITOR_FEED_WINDOW_SEC=1800

# Quiet grace window for long-running commands before stronger warnings.
# Default: 180
CODEX_MONITOR_LONG_OP_GRACE_SEC=180

# Seconds to retain tracked dispatch jobs.
# Default: 604800
CODEX_MONITOR_TRACK_TTL_SEC=604800

# Approximate uncached input token cost per 1M tokens.
# Default: 1.25
CODEX_MONITOR_COST_INPUT=1.25

# Approximate cached input token cost per 1M tokens.
# Default: 0.125
CODEX_MONITOR_COST_CACHED=0.125

# Approximate output token cost per 1M tokens.
# Default: 10.0
CODEX_MONITOR_COST_OUTPUT=10.0

# Host for the monitor web server.
# Default: 127.0.0.1
CODEX_MONITOR_HOST=127.0.0.1

# Port for the monitor web server.
# Default: 8787
CODEX_MONITOR_PORT=8787

# Command used by the monitor retry action.
# Default: codex
CODEX_MONITOR_DISPATCH=codex
